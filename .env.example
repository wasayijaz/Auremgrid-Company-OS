# Auremgrid private-host example environment.
# Copy to .env and edit for your host. Do not put provider secrets here.

# Required by deploy/docker-compose.yml for the worker command.
AUREMGRID_ORGANIZATION_ID=org_your_agency

# Local/private proxy name. For a real domain, configure DNS/TLS/firewall first.
AUREMGRID_DOMAIN=localhost

# Native-host defaults used by scripts/prepare-deploy.ps1.
AUREMGRID_DB_PATH=.\data\auremgrid.sqlite
AUREMGRID_BACKUP_DIR=.\data\backups

# Native Caddyfile default. Compose overrides this to web:8791.
AUREMGRID_UPSTREAM=127.0.0.1:8791

# Optional worker identity for native worker scripts.
AUREMGRID_WORKER_ID=worker-private-host-1
